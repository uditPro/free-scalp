# Canonical deployment origin. http is supported ONLY for local development.
APP_URL=http://localhost:3000
# Optional explicit origin for canonical tags, JSON-LD, robots, and sitemap.
# Set this to the final non-redirecting production host when apex and www are
# both active (for example: https://www.reachflow.lol).
SEO_CANONICAL_ORIGIN=
APP_ENV=development
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Server-only secrets: never use NEXT_PUBLIC_ for these.
# Not required for signup/login. Required for search quota and billing services.
SUPABASE_SECRET_KEY=
# Optional local-only Supabase Management API token for `npm run setup:supabase`.
# It must have database/auth management permissions and must never be deployed.
SUPABASE_ACCESS_TOKEN=
# Legacy NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY /
# SUPABASE_SERVICE_ROLE_KEY names remain supported as fallbacks.
# SUPABASE_JWKS_URL is not needed: the Auth SDK verifies sessions with getUser().
EXA_API_KEY=
# Optional, server-only. Used for official Places API corroboration only.
GOOGLE_PLACES_API_KEY=
# auto: dedicated Exa API when a key exists; otherwise keyless Exa MCP.
# Keyless usage is rate limited and is not a production SLA.
SEARCH_PROVIDER=auto
# Optional managed OpenAI-compatible AI for resume drafts and interview prep.
# If unset, deterministic matching and drafts remain available.
AI_MANAGED_BASE_URL=
AI_MANAGED_MODEL=
AI_MANAGED_API_KEY=
# Server-only 32-byte hex or base64 key for encrypting per-user AI keys.
AI_BYOK_ENCRYPTION_KEY=
# Outreach agent: email provider and protected hourly heartbeat.
RESEND_API_KEY=
OUTREACH_FROM_EMAIL=
OUTREACH_SENDER_NAME=ReachFlow
OUTREACH_REPLY_TO=
CRON_SECRET=
# Optional Windows-only local Agent-Reach bridge.
REACHFLOW_WORKER_URL=http://127.0.0.1:8787
REACHFLOW_WORKER_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Homepage and employer one-time payments need the secret and webhook keys above.
# Recurring monthly Stripe prices (one price per plan).
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
